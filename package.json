{
  "name": "@dsh-external/dsh-split-panes",
  "description": "Independent conversation runtimes with shared outer session navigation and the active view BetterSidebar.",
  "version": "0.7.0-dsh02.5",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "docs/LOCAL-FORK.md",
    "docs/THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.isolated.json && tsc -p tsconfig.transport.json",
    "test": "vitest run --config vitest.isolated.config.ts",
    "vendor:renderer": "node scripts/sync-renderer-vendor.mjs",
    "vendor:renderer:check": "node scripts/sync-renderer-vendor.mjs --check",
    "icons:sync": "node scripts/sync-icons.mjs",
    "icons:check": "node scripts/sync-icons.mjs --check",
    "upgrade:core": "node scripts/upgrade-core.mjs",
    "bundle:portable": "node scripts/check-bundle-portability.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run bundle:portable",
    "typecheck:native-diagnostic": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test:native-diagnostic": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.0",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.0-rc.2",
    "dsh-better-sidebar": "^0.24.1 || 0.24.1-dsh02.1",
    "@deepseek-ai/dsh-client-ui-settings-general": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/use-sync-external-store": "^1.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "use-sync-external-store": "1.2.0",
    "vitest": "^4.1.1",
    "lightningcss": "^1.30.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/dom": "^10.4.0",
    "jsdom": "^26.0.0",
    "vite-tsconfig-paths": "^5.1.0",
    "ws": "8.21.3",
    "@types/ws": "^8.18.1",
    "dsh-better-sidebar": "link:../dsh-better-sidebar"
  },
  "license": "BSD-3-Clause"
}
